# ---------------------------------------------------------------------------
# FOQUS environment
#
# Every variable here is OPTIONAL. With none of them set the app still runs in
# full local-only mode: IndexedDB is the database, and Settings → Sinkronisasi
# reports "Mode lokal". Sync and Google Calendar switch on once these are filled.
# ---------------------------------------------------------------------------

# --- Supabase (cross-device sync + auth) -----------------------------------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used exclusively by /app/api/gcal/* to read the Google refresh
# token, which RLS hides from every client role. NEVER prefix this with
# NEXT_PUBLIC_ and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Calendar --------------------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# (Web application). Authorized redirect URI:
#   https://<your-app>/api/gcal/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Absolute origin of the deployment, used to build the OAuth redirect URI.
# Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
