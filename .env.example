# ---------------------------------------------------------------------------
# FOQUS environment
#
# Every variable here is OPTIONAL. With none of them set the app still runs in
# full local-only mode: IndexedDB is the database, the gate is open, and
# Settings → Sinkronisasi reports "Mode lokal". Sync, Google Calendar and the
# access gate switch on once these are filled.
#
# Everything here is a *credential* or an *address*. Anything that is a
# preference — which calendar agendas are written to, whether they are written
# at all, which calendars count as busy, how wide the sync window is — is set
# inside the app, in Pengaturan → Google Calendar.
# ---------------------------------------------------------------------------

# --- Access gate ------------------------------------------------------------
# The password that stands in front of the whole deployment. Leave it empty in
# local development and the gate is off entirely.
#
# It also signs the session cookie, so changing it signs every device out.
# Server-only: never prefix it with NEXT_PUBLIC_.
FOQUS_ACCESS_PASSWORD=

# --- Supabase (cross-device sync + auth) -----------------------------------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used exclusively by /app/api/gcal/* to read the Google refresh
# token, which RLS hides from every client role. NEVER prefix this with
# NEXT_PUBLIC_ and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Calendar --------------------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# (Web application). Authorized redirect URI:
#   https://<your-app>/api/gcal/callback
#
# The client *secret* stays here rather than in the app: it is a deployment
# credential, and a table the browser can write is the wrong place for one.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Absolute origin of the deployment, used to build the OAuth redirect URI.
# Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
